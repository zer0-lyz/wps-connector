{
  "name": "wps-connector",
  "version": "0.2.1",
  "private": true,
  "description": "Local WPS bridge for Codex-style MCP tools.",
  "type": "module",
  "scripts": {
    "bridge": "node apps/bridge/server.js",
    "mcp": "node apps/mcp/server.js",
    "simulator": "node apps/wps-addin/simulator.js",
    "check": "node --check apps/bridge/codexAgent.js && node --check apps/bridge/server.js && node --check apps/mcp/server.js && node --check apps/shared/toolSchemas.js && node --check apps/wps-addin/main.js && node --check apps/wps-addin/simulator.js && node --check scripts/sync-codex-catalog.js && node --check scripts/agent-connection-status.js && node --check scripts/agent-tool-call.js && node --check tests/fixtures/fake-codex-app-server.js && node --check tests/e2e.js",
    "check:mac": "npm run check && node --check scripts/disable-wps-js-debug-mac.js",
    "test": "node tests/e2e.js",
    "test:et": "node scripts/regression-et.js",
    "sync:plugin-runtime:mac": "bash scripts/sync-plugin-runtime-mac.sh",
    "deploy": "bash scripts/deploy-runtime-mac.sh && node scripts/disable-wps-js-debug-mac.js",
    "install:mac": "bash scripts/install-mac.sh",
    "deploy:runtime:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-runtime-windows.ps1",
    "register:addin:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/register-wps-addin-windows.ps1",
    "install:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "bootstrap:mac": "bash scripts/bootstrap-mac.sh",
    "runtime:start": "bash scripts/start-runtime-mac.sh",
    "runtime:stop": "bash scripts/stop-runtime-mac.sh",
    "launchd:install": "bash scripts/install-launch-agent-mac.sh",
    "wps:disable-js-debug": "node scripts/disable-wps-js-debug-mac.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sql.js": "1.14.1",
    "ws": "^8.21.1"
  }
}
